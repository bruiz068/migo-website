# Analytics Configuration
# Replace these placeholder values with your actual tracking IDs

# Google Analytics 4 Measurement ID
# Get this from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity Project ID  
# Get this from: https://clarity.microsoft.com/
# Format: random string like "abcd1234"
NEXT_PUBLIC_CLARITY_PROJECT_ID=CLARITY_PROJECT_ID

# Google Search Console Verification
# Get this from: https://search.google.com/search-console
# Format: random string for meta tag verification
NEXT_PUBLIC_GOOGLE_VERIFICATION=verification-code-placeholder

# Hotjar Site ID (Optional)
# Get this from: https://www.hotjar.com/
# Format: numeric ID
NEXT_PUBLIC_HOTJAR_ID=

# Facebook Pixel ID (Optional)
# Get this from: https://business.facebook.com/
# Format: numeric ID  
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace placeholder values with your actual tracking IDs
# 3. Restart your development server
# 4. The analytics will automatically start tracking

# Production Notes:
# - Add these environment variables to your hosting platform (Vercel, Netlify, etc.)
# - Make sure NEXT_PUBLIC_ prefix is included for client-side access
# - Keep your tracking IDs secure and don't commit real values to git

# ============================================================
# Twilio (Sofia AI SMS confirmation messages)
# ============================================================
# Required for the /api/sofia-sms-consent route to send the
# confirmation SMS after an operator submits the consent form.
#
# Get these from: https://console.twilio.com/
# Account SID and Auth Token live on the main Console dashboard.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Sender — set EITHER TWILIO_MESSAGING_SERVICE_SID (preferred,
# required once your A2P 10DLC campaign is approved) OR
# TWILIO_FROM_NUMBER. Messaging Service SID wins if both are set.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+14805550100

# ============================================================
# Email (Sofia AI consent record notifications)
# ============================================================
# Used by /api/sofia-sms-consent and /api/contact to email
# Bernardo a copy of each submission. Required for compliance
# recordkeeping.

GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
CONTACT_EMAIL=bernardo@migonow.com

# ============================================================
# ActiveCampaign (optional — used by /api/contact)
# ============================================================
ACTIVECAMPAIGN_API_URL=https://your-account.api-us1.com
ACTIVECAMPAIGN_API_KEY=your_activecampaign_api_key
